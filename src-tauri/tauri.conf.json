{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kindle Cards",
  "version": "0.1.0",
  "identifier": "com.kindlevocab.cards",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kindle Cards",
        "width": 1320,
        "height": 840,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
